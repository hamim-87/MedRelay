# Copy to .env (never commit .env). The notebook reads MEDRELAY_* from the process environment.
MEDRELAY_MODE=fast          # fast | full
MEDRELAY_HEADLESS=0         # 1 disables the ipywidgets demo (used by scripts/run_notebook.py)
# Remote LLMs are disabled by design. Leave unset unless a remote backend is explicitly authorised AND the data are permitted/synthetic.
# MEDRELAY_REMOTE_LLM_ENDPOINT=
# MEDRELAY_REMOTE_LLM_TOKEN=
